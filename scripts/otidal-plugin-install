#!/usr/bin/env bash
set -euo pipefail

project_dir="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd)"
plugin_src="$project_dir/omarchy-plugin"
plugins_dir="${XDG_CONFIG_HOME:-$HOME/.config}/omarchy/plugins"
plugin_dst="$plugins_dir/community.otidal"
backup_dir="$project_dir/.dev/plugin-install"
shell_json="${XDG_CONFIG_HOME:-$HOME/.config}/omarchy/shell.json"

mkdir -p "$backup_dir" "$plugins_dir"
chmod 700 "$project_dir/.dev" "$backup_dir" 2>/dev/null || true

if [[ -f $shell_json && ! -f $backup_dir/shell.json ]]; then
  cp -a "$shell_json" "$backup_dir/shell.json"
fi

omarchy plugin validate "$plugin_src"

if [[ -e $plugin_dst || -L $plugin_dst ]]; then
  echo "community.otidal is already present at $plugin_dst"
else
  ln -s "$plugin_src" "$plugin_dst"
  echo "Linked $plugin_dst -> $plugin_src"
fi

omarchy-shell shell rescanPlugins >/dev/null
omarchy plugin enable community.otidal --section right --before omarchy.audio

echo "Installed community.otidal on the right side of the bar."
echo "Rollback with: $project_dir/scripts/otidal-plugin-rollback"
